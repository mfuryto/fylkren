{
  "name": "fylkren",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "pnpm -r build",
    "check:docs": "node tools/check-documentation-links.mjs",
    "check:language": "node tools/check-repository-language.mjs",
    "check:language:full": "node tools/check-repository-language.mjs --full",
    "check:structure": "node tools/check-source-structure.mjs && node tools/check-repository-language.mjs",
    "check:version": "node tools/check-version-consistency.mjs",
    "dev:web": "pnpm --filter @fylkren/web dev",
    "dev:demo": "pnpm --filter @fylkren/demo dev",
    "test": "pnpm -r test",
    "test:e2e:local": "node tools/run-e2e-editions.mjs",
    "test:e2e:editions": "node tools/run-e2e-editions.mjs",
    "test:e2e:identity-directory": "node tools/run-identity-directory-lab.mjs",
    "test:e2e:identity-ad": "node tools/run-identity-ad-lab.mjs",
    "test:e2e:identity-sso": "node tools/run-identity-sso-lab.mjs",
    "test:e2e:license-expiry": "node tools/run-license-expiry.mjs",
    "typecheck": "pnpm -r typecheck"
  }
}
