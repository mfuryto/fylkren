{
  "name": "fylkren",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "pnpm -r build",
    "check:docs": "node tools/check-documentation-links.mjs && node tools/check-security-evidence.mjs",
    "check:security-evidence": "node tools/check-security-evidence.mjs",
    "check:language": "node tools/check-repository-language.mjs",
    "check:language:full": "node tools/check-repository-language.mjs --full",
    "check:structure": "node tools/check-source-structure.mjs && node tools/check-repository-language.mjs",
    "check:version": "node tools/check-version-consistency.mjs",
    "dev:web": "pnpm --filter @fylkren/web dev",
    "dev:demo": "pnpm --filter @fylkren/demo dev",
    "test": "pnpm -r test",
    "test:e2e:local": "node tools/run-e2e-editions.mjs",
    "test:e2e:editions": "node tools/run-e2e-editions.mjs",
    "test:e2e:identity-directory": "node tools/run-identity-directory-lab.mjs",
    "test:e2e:identity-ad": "node tools/run-identity-ad-lab.mjs",
    "test:e2e:identity-sso": "node tools/run-identity-sso-lab.mjs",
    "test:security:browser-boundaries": "node tools/test-browser-technology-redirects.mjs",
    "test:security:response-media-types": "node tools/test-response-media-types.mjs",
    "test:security:http-upgrade": "node tools/test-http-upgrade-boundary.mjs",
    "test:security:intermediary-headers": "node tools/test-intermediary-header-boundary.mjs",
    "test:security:http-message-boundary": "node tools/test-http-message-boundary.mjs",
    "test:security:file-inventory": "node tools/test-file-handling-inventory.mjs",
    "security:sbom": "node tools/security/generate-release-sbom.mjs",
    "test:e2e:license-expiry": "node tools/run-license-expiry.mjs",
    "typecheck": "pnpm -r typecheck",
    "test:e2e:browser": "node tools/run-release-browser.mjs",
    "test:e2e:totp": "node tools/run-release-browser.mjs --totp-only",
    "test:e2e:webauthn": "node tools/run-release-browser.mjs --webauthn-only",
    "test:e2e:postgres-upgrade": "node tools/e2e/postgres-nonroot-upgrade.mjs"
  }
}
