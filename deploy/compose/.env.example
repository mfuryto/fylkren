# deploy/compose/install.sh copies this template and replaces the placeholder
# with a random value before the first start. Do not rotate it manually later.
FYLKREN_DB_PASSWORD=replace-with-a-long-random-password

# Origin port used by the trusted reverse proxy. Bind it to loopback when the
# proxy runs on this host; use a firewall-restricted address otherwise. Never
# expose this origin directly when forwarded-header trust is enabled.
FYLKREN_HTTP_PORT=127.0.0.1:8080
# Canonical origin used in email notifications, permalinks and Host validation.
# Use only scheme, hostname and optional port, without a path or trailing slash.
FYLKREN_PUBLIC_URL=http://localhost:8080

# Set both to true only when TLS terminates in a trusted reverse proxy which
# replaces Host, X-Forwarded-Proto and X-Forwarded-For. Leave both false for
# direct HTTP on an internal network.
FYLKREN_TRUST_FORWARDED_HEADERS=false
# Number of trusted proxy hops in front of the API. Keep 1 unless a trusted
# outer reverse proxy is used and direct access to the origin port is blocked.
FYLKREN_FORWARDED_HEADER_LIMIT=1
FYLKREN_REQUIRE_HTTPS=false
# Federation history retention: 365-3650 days; default 2555 (seven years).
FYLKREN_FEDERATION_RETENTION_DAYS=2555

# Language, time zone, clock format and measurement system are managed in
# Platform Manager -> Appearance and stored in the database.
FYLKREN_HOST_STATUS_MAXIMUM_AGE_MINUTES=15
FYLKREN_BACKUP_WARNING_HOURS=36
# Complete local backup sets retained under <Fylkren root>/backups (2-365).
# External backup storage must apply its own independent retention policy.
FYLKREN_LOCAL_BACKUP_RETENTION_COUNT=14

# Legacy one-time migration value. Afterwards use Platform Manager -> Identity.
FYLKREN_LOCAL_AUTH_ENABLED=true
# Show and enforce TOTP, passkeys and WebAuthn. Set false for installations
# where additional authentication is intentionally handled outside Fylkren.
FYLKREN_MFA_ENABLED=true
FYLKREN_MFA_REQUIRED=true
# Optional additional trusted public key for issuer-key rotation or isolated tests.
# The production THUNOLD-OLSEN public verification key is already bundled.
FYLKREN_LICENSE_PUBLIC_KEY_SPKI=

# Outbound HTTPS integrations block private/reserved destinations by default.
# Approve required internal receivers/IdPs/peers by exact origin, separated by ;.
# Include the port. No paths, credentials, wildcards or metadata/link-local IPs.
# Example: https://idp.internal:8443;https://peer.internal:443
FYLKREN_OUTBOUND_PRIVATE_ORIGINS=
# OIDC backchannel endpoints default to the configured authority's origin.
# Add exact origins only if the provider uses a separate JWKS/token/userinfo host.
FYLKREN_OUTBOUND_IDENTITY_ORIGINS=

# Legacy one-time migration source. Configure identity providers in Platform
# Manager -> Identity. On the first upgraded startup these values are imported
# into protected database settings; later changes here do not overwrite the GUI.
FYLKREN_OIDC_ENABLED=false
FYLKREN_OIDC_AUTHORITY=
FYLKREN_OIDC_CLIENT_ID=
FYLKREN_OIDC_CLIENT_SECRET=
FYLKREN_OIDC_CALLBACK_PATH=/signin-oidc

FYLKREN_SAML_ENABLED=false
FYLKREN_SAML_METADATA_URL=
FYLKREN_SAML_ENTITY_ID=
FYLKREN_SAML_IDP_ENTITY_ID=
FYLKREN_SAML_MODULE_PATH=/api/auth/saml2

FYLKREN_AD_ENABLED=false
FYLKREN_AD_SERVER=
FYLKREN_AD_DOMAIN=
FYLKREN_AD_BASE_DN=
FYLKREN_AD_USER_SEARCH_BASE=
FYLKREN_AD_PORT=636
FYLKREN_AD_USE_SSL=true
FYLKREN_AD_USE_STARTTLS=false
FYLKREN_AD_BIND_DN=
FYLKREN_AD_BIND_PASSWORD=
FYLKREN_AD_USERNAME_ATTRIBUTE=sAMAccountName
# Static LDAP filter defining an active AD account. The default excludes the
# ACCOUNTDISABLE bit; account expiry is also checked independently.
FYLKREN_AD_LIFECYCLE_ACTIVE_FILTER=(!(userAccountControl:1.2.840.113556.1.4.803:=2))

FYLKREN_LDAP_ENABLED=false
FYLKREN_LDAP_SERVER=
FYLKREN_LDAP_BASE_DN=
FYLKREN_LDAP_USER_SEARCH_BASE=
FYLKREN_LDAP_PORT=636
FYLKREN_LDAP_USE_SSL=true
FYLKREN_LDAP_USE_STARTTLS=false
FYLKREN_LDAP_BIND_DN=
FYLKREN_LDAP_BIND_PASSWORD=
FYLKREN_LDAP_USERNAME_ATTRIBUTE=uid
FYLKREN_LDAP_DISPLAY_NAME_ATTRIBUTE=displayName
FYLKREN_LDAP_EMAIL_ATTRIBUTE=mail
FYLKREN_LDAP_STABLE_ID_ATTRIBUTE=entryUUID
# Adapt this static filter to the LDAP server's disabled-account schema. The
# default treats every existing entry as active; confirmed deletion is still
# detected through entryUUID.
FYLKREN_LDAP_LIFECYCLE_ACTIVE_FILTER=(objectClass=*)

# Automatic directory lifecycle. An explicit disabled result suspends access at
# once. A missing entry must be confirmed by this many successful checks.
FYLKREN_DIRECTORY_LIFECYCLE_ENABLED=true
FYLKREN_DIRECTORY_LIFECYCLE_INTERVAL_MINUTES=15
FYLKREN_DIRECTORY_LIFECYCLE_MISSING_CONFIRMATIONS=3

# WebAuthn/passkeys require HTTPS. The only HTTP exception supported by browsers
# is localhost development. Keep disabled for direct HTTP on an internal hostname.
FYLKREN_WEBAUTHN_ENABLED=false
FYLKREN_WEBAUTHN_RP_ID=example.invalid
FYLKREN_WEBAUTHN_DISPLAY_NAME=Fylkren
FYLKREN_WEBAUTHN_ORIGIN=https://example.invalid
